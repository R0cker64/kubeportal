{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/kubeconfig*)",
      "Read(~/.kube/**)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl config use-context:*)",
      "Bash(helm uninstall:*)",
      "Bash(git push --force:*)"
    ]
  }
}
