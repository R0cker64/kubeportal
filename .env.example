# Example values only. Copy to .env for local development; never commit .env.
KUBEPORTAL_LISTEN_ADDR=:8080
KUBEPORTAL_PUBLIC_URL=http://localhost:8080
KUBEPORTAL_OIDC_ISSUER_URL=http://localhost:8180/realms/kubeportal
KUBEPORTAL_OIDC_JWKS_URL=http://keycloak.keycloak.svc:8080/realms/kubeportal/protocol/openid-connect/certs
KUBEPORTAL_OIDC_CLIENT_ID=kubeportal
KUBEPORTAL_OIDC_CLIENT_SECRET=change-me
KUBEPORTAL_ADMIN_GROUP=kubeportal-admin
KUBEPORTAL_ENVIRONMENTS=dev,staging,prod
KUBEPORTAL_LOKI_URL=http://loki-gateway.monitoring.svc
KUBEPORTAL_PROMETHEUS_URL=http://prometheus-server.monitoring.svc
KUBEPORTAL_DATABASE_URL=postgres://kubeportal:change-me@localhost:5432/kubeportal?sslmode=disable
KUBEPORTAL_LOGS_MAX_RANGE=168h
KUBEPORTAL_LOGS_MAX_LINES=5000
