{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "KubePortal chart values",
  "type": "object",
  "required": ["image", "config", "secrets", "service", "resources", "networkPolicy"],
  "definitions": {
    "httpURL": { "type": "string", "pattern": "^https?://[^\\s/]+(/\\S*)?$" },
    "duration": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$" },
    "positiveInt": { "type": "integer", "minimum": 1 },
    "dnsLabel": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
    "secretRef": {
      "type": "object",
      "required": ["name", "key"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/definitions/dnsSubdomain" },
        "key": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" }
      }
    },
    "dnsSubdomain": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$", "maxLength": 253 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
  },
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "config": {
      "type": "object",
      "required": [
        "publicURL", "environments", "adminGroup", "oidc", "lokiURL", "prometheusURL",
        "cadvisorNodeLabel"
      ],
      "additionalProperties": false,
      "properties": {
        "publicURL": { "$ref": "#/definitions/httpURL" },
        "environments": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(, *[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "logLevel": { "enum": ["debug", "info", "warn", "error"] },
        "adminGroup": { "type": "string", "minLength": 1, "maxLength": 255 },
        "oidc": {
          "type": "object",
          "required": ["issuerURL", "clientID"],
          "additionalProperties": false,
          "properties": {
            "issuerURL": { "$ref": "#/definitions/httpURL" },
            "discoveryURL": {
              "oneOf": [{ "$ref": "#/definitions/httpURL" }, { "type": "string", "maxLength": 0 }]
            },
            "clientID": { "type": "string", "minLength": 1 }
          }
        },
        "lokiURL": { "$ref": "#/definitions/httpURL" },
        "prometheusURL": { "$ref": "#/definitions/httpURL" },
        "cadvisorNodeLabel": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
        "sessionTTL": { "$ref": "#/definitions/duration" },
        "sessionIdleTimeout": { "$ref": "#/definitions/duration" },
        "upstreamTimeout": { "$ref": "#/definitions/duration" },
        "logMaxRange": { "$ref": "#/definitions/duration" },
        "logMaxLines": { "$ref": "#/definitions/positiveInt" },
        "logMaxSearchLen": { "$ref": "#/definitions/positiveInt" },
        "liveTailsPerUser": { "$ref": "#/definitions/positiveInt" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["oidcClientSecret", "databaseURL", "sessionKey"],
      "additionalProperties": false,
      "properties": {
        "oidcClientSecret": { "$ref": "#/definitions/secretRef" },
        "databaseURL": { "$ref": "#/definitions/secretRef" },
        "sessionKey": { "$ref": "#/definitions/secretRef" }
      }
    },
    "service": {
      "type": "object",
      "required": ["port"],
      "properties": { "port": { "$ref": "#/definitions/port" } }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits": { "type": "object", "required": ["cpu", "memory"] }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "apiServer": {
          "type": "object",
          "properties": {
            "cidrs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "ports": { "type": "array", "items": { "$ref": "#/definitions/port" } }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["ports"],
            "properties": {
              "namespace": { "type": "string" },
              "podLabels": { "type": "object" },
              "cidrs": { "type": "array", "items": { "type": "string" } },
              "ports": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/port" } }
            }
          }
        }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "podAnnotations": { "type": "object" }
  }
}
