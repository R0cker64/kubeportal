{
  "realm": "kubeportal",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "groups": [
    { "name": "kubeportal-admin" },
    { "name": "team-payments" },
    { "name": "team-catalog" },
    { "name": "team-search" }
  ],
  "clientScopes": [
    {
      "name": "groups",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    { "name": "openid", "protocol": "openid-connect" },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "kubeportal",
      "name": "KubePortal",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KUBEPORTAL_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8080/auth/callback", "http://localhost:4200/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/##http://localhost:4200/"
      },
      "defaultClientScopes": ["openid", "profile", "groups"]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "email": "admin@kubeportal.local",
      "emailVerified": true,
      "groups": ["kubeportal-admin"],
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }]
    },
    {
      "username": "alice",
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Payments",
      "email": "alice@kubeportal.local",
      "emailVerified": true,
      "groups": ["team-payments"],
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }]
    },
    {
      "username": "bob",
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Catalog",
      "email": "bob@kubeportal.local",
      "emailVerified": true,
      "groups": ["team-catalog"],
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }]
    },
    {
      "username": "dave",
      "enabled": true,
      "firstName": "Dave",
      "lastName": "Search",
      "email": "dave@kubeportal.local",
      "emailVerified": true,
      "groups": ["team-search"],
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }]
    },
    {
      "username": "carol",
      "enabled": true,
      "firstName": "Carol",
      "lastName": "Unmapped",
      "email": "carol@kubeportal.local",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }]
    }
  ]
}
